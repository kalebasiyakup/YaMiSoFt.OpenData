{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenData": {
    "RateLimit": {
      "Enabled": true,
      "ApiKeyHeader": "X-API-Key",
      "EdgeBurstProtection": false,
      "RedisConnectionString": "",
      "Anonymous": {
        "PerMinute": 30,
        "PerDay": 1000
      },
      "ApiKey": {
        "PerMinute": 120,
        "PerDay": 10000
      },
      "BulkDownload": {
        "PerMinute": 5,
        "PerDay": 100
      }
    },
    "Cache": {
      "Default": "1.00:00:00",
      "Search": "00:05:00"
    },
    "Proxy": {
      "Provider": "None",
      "KnownProxies": [],
      "KnownNetworks": []
    }
  }
}
