{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "Dockerfile.vercel": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
